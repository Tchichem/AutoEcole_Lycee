{% extends 'base.html.twig' %}

{% block title %}Elèves{% endblock %}

{% block body %}
<h1>Elèves</h1>
<form method="get" action="{{ path('app_eleves') }}">
    Rechercher : <input type="text" name="search" value="{{ app.request.query.get('search') }}">
    <button type="submit">Entrer</button>
</form>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Date de naissance</th>
            <th>Date d'inscription</th>
            <th>Code</th>
            <th>Conduite</th>
        </tr>
    </thead>
    <tbody>
        {% for eleve in eleves %}
        <tr>
            <td>{{ eleve.idEleve }}</td>
            <td>{{ eleve.nomEleve }}</td>
            <td>{{ eleve.prenomEleve }}</td>
            <td>{{ eleve.dateNaissanceEleve|date('d/m/Y') }}</td>
            <td>{{ eleve.dateInscription|date('d/m/Y') }}</td>
            <td>{{ eleve.code ? 'Obtenu' : 'Non obtenu' }}</td>
            <td>{{ eleve.conduite ? 'Obtenu' : 'Non obtenu' }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{{ knp_pagination_render(eleves) }}

<h2>Effectuer une inscription</h2>
{{ form_start(form) }}
    {{ form_row(form.nom_eleve) }}
    {{ form_row(form.prenom_eleve) }}
    {{ form_row(form.date_naissance_eleve) }}
    {{ form_row(form.code) }}
    {{ form_row(form.conduite) }}
    <button type="submit">Enregistrer</button>
{{ form_end(form) }}
{% endblock %}